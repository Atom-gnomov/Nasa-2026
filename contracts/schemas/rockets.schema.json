{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rockets.schema.json",
  "title": "Каталог сучасних ракет (app/data/rockets.json)",
  "description": "Ракети для вибору старту до Місяця (П-12, задача D7): місткість на НОО й на траєкторію до Місяця (TLI), ціна, статус, багаторазовість. Кожен факт — з джерелом і дослівною цитатою; чого в джерелах немає, того немає й тут. Способи старту й космодроми — launch_systems.json і launch_sites.json (D6), тут не дублюються.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "manufacturer",
      "status",
      "status_note",
      "reusability",
      "verified_by_flight",
      "checked",
      "launch_site_ids",
      "facts"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "manufacturer": {
        "type": "string"
      },
      "family": {
        "type": "string",
        "description": "Спільна назва конфігурацій однієї ракети (Vulcan, New Glenn)"
      },
      "status": {
        "enum": [
          "active",
          "in_testing",
          "design_target",
          "retired"
        ],
        "description": "діюча · у випробуваннях · проєктна ціль · знята з експлуатації"
      },
      "status_note": {
        "type": "string",
        "description": "Чому саме такий статус, з датою події"
      },
      "reusability": {
        "enum": [
          "expendable",
          "first_stage",
          "full"
        ],
        "description": "Що повертається й літає знову (заявлено виробником)"
      },
      "verified_by_flight": {
        "type": "boolean",
        "description": "Ця конфігурація вже літала; false — числа лише проєктні"
      },
      "checked": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Дата останньої перевірки джерел"
      },
      "launch_site_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "id з app/data/launch_sites.json; порожньо — майданчика ще немає в каталозі (див. site_note)"
      },
      "site_note": {
        "type": "string"
      },
      "launch_system_id": {
        "type": "string",
        "description": "id відповідної системи в launch_systems.json (D6), якщо вона там є"
      },
      "facts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "quantity",
            "value",
            "source",
            "quote"
          ],
          "additionalProperties": false,
          "properties": {
            "quantity": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$",
              "description": "capacity_leo_kg, capacity_tli_kg, capacity_gto_kg, capacity_geo_kg, capacity_mars_kg, price_usd_per_kg_lunar_surface, flight_tests…; D8: price_usd_per_kg_leo_min / price_usd_per_kg_leo_max ($/кг на НОО діапазоном), flights_total / flights_failed (статистика польотів, з as_of), nasa_launch_contract_usd, production_cost_usd"
            },
            "value": {
              "type": [
                "number",
                "string"
              ]
            },
            "unit": {
              "type": "string"
            },
            "bound": {
              "enum": [
                "exact",
                "at_least"
              ],
              "description": "at_least — у джерелі «більше ніж» / «щонайменше»"
            },
            "as_published": {
              "type": "string"
            },
            "condition": {
              "type": "string",
              "description": "Орбіта, конфігурація, режим повернення ступенів, рік"
            },
            "source": {
              "type": "object",
              "required": [
                "title",
                "ref",
                "url",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "date": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "primary",
                    "secondary"
                  ]
                }
              }
            },
            "quote": {
              "type": "string",
              "minLength": 10
            },
            "note": {
              "type": "string"
            },
            "as_of": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Дата, станом на яку пораховано значення, що змінюється з часом (кількість польотів)"
            },
            "derivation": {
              "type": "string",
              "description": "Як значення обчислено з цитованого джерела (наприклад, ціна контракту / місткість на НОО)"
            }
          },
          "dependentRequired": {
            "as_published": [
              "unit"
            ]
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "quantity": {
                    "enum": [
                      "flights_total",
                      "flights_failed"
                    ]
                  }
                },
                "required": [
                  "quantity"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unit": {
                    "const": "flights"
                  }
                },
                "required": [
                  "as_of",
                  "unit"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "quantity": {
                    "enum": [
                      "price_usd_per_kg_leo_min",
                      "price_usd_per_kg_leo_max"
                    ]
                  }
                },
                "required": [
                  "quantity"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "USD/kg"
                  }
                },
                "required": [
                  "unit"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
