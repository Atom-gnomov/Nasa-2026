# Скопіюйте в .env (файл у .gitignore) і заповніть. Значення тут — приклад без секретів.
# Поради ШІ (POST /api/advice): будь-який сервіс з OpenAI-сумісним API (POST {BASE_URL}/chat/completions).
# Без LSE_LLM_BASE_URL блок порад вимкнений, решта застосунку працює.

# Базова адреса API сервісу (https; http — лише для localhost). Приклад — TokenHarbor, безкоштовна модель:
LSE_LLM_BASE_URL=https://tokenharbor.ai/v1
# Назва моделі в цьому сервісі (для TokenHarbor — безкоштовна DeepSeek V4.1 Flash)
LSE_LLM_MODEL=deepseek-v4.1-flash:free
# Ключ доступу (токен) сервісу. НЕ комітьте: .env у .gitignore
LSE_LLM_API_KEY=
# Таймаут запиту до сервісу, секунди
LSE_LLM_TIMEOUT_S=30

# Автоматична підготовка даних NASA у фоні (README, «Змінні середовища»): 0 — вимкнути
LSE_AUTO_PREPARE=1
# Які набори готувати самі: temperature (≈ 3,4 ГБ), system (≈ 6 МБ), globe (≈ 1,3 ГБ і більше)
LSE_AUTO_PREPARE_DATASETS=temperature,system
